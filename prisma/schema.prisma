// Prisma Schema for Family Finance
// Self-hosted financial intelligence dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FAMILY_MEMBER
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  MORTGAGE
  INVESTMENT
  ASSET
  OTHER
}

enum PlaidItemStatus {
  ACTIVE
  ERROR
  PENDING_EXPIRATION
}

enum PayoffStrategy {
  AVALANCHE
  SNOWBALL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plaidItems        PlaidItem[]
  accounts          Account[]
  transactions      Transaction[]
  debts             Debt[]
  debtPayoffPlans   DebtPayoffPlan[]
  netWorthSnapshots NetWorthSnapshot[]

  @@map("users")
}

model PlaidItem {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEnc  String
  itemId          String          @unique
  institutionId   String?
  institutionName String?
  status          PlaidItemStatus @default(ACTIVE)
  lastSyncedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  accounts        Account[]

  @@map("plaid_items")
}

model Account {
  id                     String      @id @default(cuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId            String?
  plaidItem              PlaidItem?  @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  plaidAccountId         String?     @unique

  name                   String
  officialName           String?
  type                   AccountType
  subtype                String?
  currentBalance         Decimal     @db.Decimal(12, 2)
  availableBalance       Decimal?    @db.Decimal(12, 2)
  creditLimit            Decimal?    @db.Decimal(12, 2)
  currency               String      @default("USD")
  isManual               Boolean     @default(false)
  isExcludedFromNetWorth Boolean     @default(false)

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  debt                   Debt?
  transactions           Transaction[]

  @@map("accounts")
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  balance         Decimal  @db.Decimal(12, 2)
  apr             Decimal  @db.Decimal(5, 2)
  minimumPayment  Decimal  @db.Decimal(12, 2)
  dueDate         Int?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("debts")
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  plaidTransactionId String?  @unique
  amount             Decimal  @db.Decimal(12, 2)
  date               DateTime
  name               String
  merchantName       String?
  category           String?
  subCategory        String?
  pending            Boolean  @default(false)
  isIgnored          Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("transactions")
}

model DebtPayoffPlan {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  name                String
  strategy            PayoffStrategy @default(AVALANCHE)
  extraMonthlyPayment Decimal        @db.Decimal(12, 2) @default(0)
  lumpSumAmount       Decimal        @db.Decimal(12, 2) @default(0)
  isDefault           Boolean        @default(true)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("debt_payoff_plans")
}

model NetWorthSnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date             DateTime @default(now())
  totalAssets      Decimal  @db.Decimal(12, 2)
  totalLiabilities Decimal  @db.Decimal(12, 2)
  netWorth         Decimal  @db.Decimal(12, 2)
  monthlyBurn      Decimal  @db.Decimal(12, 2)

  createdAt        DateTime @default(now())

  @@map("net_worth_snapshots")
}