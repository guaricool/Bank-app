# -----------------------------------------------------------------------------
# REQUIRED ENVIRONMENT VARIABLES
# Copy this file to .env and replace the placeholder values with your real keys.
# -----------------------------------------------------------------------------

# 1. Database (Neon - PostgreSQL)
# Get this from your Neon project dashboard: https://console.neon.tech
DATABASE_URL="postgresql://[user]:[password]@[host].neon.tech/bank_app?sslmode=require"

# 2. Authentication (NextAuth)
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your_generated_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"

# 3. Encryption Key (For Plaid Access Tokens)
# Generate a 32-byte secret using: openssl rand -base64 32
ENCRYPTION_KEY="your_generated_encryption_key"

# 4. Plaid (Sandbox or Production)
# Get these from your Plaid Dashboard: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID="your_plaid_client_id"
PLAID_SECRET="your_plaid_secret_key"
PLAID_ENV="sandbox" # Use 'development' or 'production' when ready
PLAID_PRODUCTS="auth,transactions,liabilities"
PLAID_COUNTRY_CODES="US,CA"
# Shared secret for non-production webhook calls — set same value in Plaid Dashboard > Sandbox webhooks
PLAID_WEBHOOK_SECRET="your_webhook_shared_secret"

# 5. Stripe (Billing and Trial)
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# 6. Email (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
